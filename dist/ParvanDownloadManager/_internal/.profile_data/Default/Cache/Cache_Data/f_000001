  <!-- Real-time Animation & Logic -->
  <script>
    // Sound Synthesizer Effects
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    function playBeep(freq = 650, duration = 0.05) {
      if (audioCtx.state === 'suspended') audioCtx.resume();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
      gain.gain.setValueAtTime(0.06, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + duration);
    }

    // Dual Streaming Chart (Download Speed + Incoming Bandwidth)
    const canvas = document.getElementById('dualSpeedChart');
    const ctx = canvas.getContext('2d');

    function fitCanvas() {
      canvas.width = canvas.parentElement.clientWidth;
      canvas.height = canvas.parentElement.clientHeight - 28;
    }
    window.addEventListener('resize', fitCanvas);
    fitCanvas();

    const points = 50;
    const downloadHistory = new Array(points).fill(70);
    const lineHistory = new Array(points).fill(80);

    let curDownload = 72.4;
    let curLineMbps = 610;

    function drawChart() {
      const w = canvas.width;
      const h = canvas.height;
      ctx.clearRect(0, 0, w, h);

      const maxVal = 120;
      const step = w / (points - 1);

      // Line 1: Internet Line Bandwidth (Emerald)
      ctx.beginPath();
      for (let i = 0; i < points; i++) {
        const x = i * step;
        const y = h - (lineHistory[i] / maxVal) * (h * 0.85);
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.strokeStyle = 'rgba(16, 185, 129, 0.7)';
      ctx.lineWidth = 1.5;
      ctx.setLineDash([4, 4]);
      ctx.stroke();
      ctx.setLineDash([]);

      // Line 2: Net Download Speed (Cyan Neon with Area Gradient)
      ctx.beginPath();
      ctx.moveTo(0, h);
      for (let i = 0; i < points; i++) {
        const x = i * step;
        const y = h - (downloadHistory[i] / maxVal) * (h * 0.85);
        ctx.lineTo(x, y);
      }
      ctx.lineTo(w, h);
      ctx.closePath();
      const grad = ctx.createLinearGradient(0, 0, 0, h);
      grad.addColorStop(0, 'rgba(0, 245, 255, 0.35)');
      grad.addColorStop(1, 'rgba(0, 245, 255, 0.0)');
      ctx.fillStyle = grad;
      ctx.fill();

      ctx.beginPath();
      for (let i = 0; i < points; i++) {
        const x = i * step;
        const y = h - (downloadHistory[i] / maxVal) * (h * 0.85);
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.strokeStyle = '#00F5FF';
      ctx.lineWidth = 2;
      ctx.shadowColor = 'rgba(0, 245, 255, 0.8)';
      ctx.shadowBlur = 8;
      ctx.stroke();
      ctx.shadowBlur = 0;
    }

    // Backend Communication Bridge
    const API_BASE = 'http://127.0.0.1:9876/api';

    let peakSpeed = 0;
    let allTasksCache = [];
    let currentTab = 'all';
    let currentCategory = null;
    let searchKeyword = '';

    // Window Controls
    document.querySelector('.win-close').onclick = () => {
      playBeep(400, 0.08);
      window.close();
    };
    document.querySelector('.win-min').onclick = () => {
      playBeep(500, 0.05);
    };
    document.querySelector('.win-max').onclick = () => {
      playBeep(700, 0.05);
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(()=>{});
      } else {
        document.exitFullscreen().catch(()=>{});
      }
    };

    // Sidebar Filters
    document.querySelectorAll('.nav-link[data-tab]').forEach(link => {
      link.onclick = () => {
        document.querySelectorAll('.nav-link[data-tab]').forEach(l => l.classList.remove('active'));
        document.querySelectorAll('.nav-link[data-cat]').forEach(l => l.classList.remove('active'));
        link.classList.add('active');
        currentTab = link.getAttribute('data-tab');
        currentCategory = null;
        playBeep(800, 0.04);
        filterAndRender();
      };
    });

    document.querySelectorAll('.nav-link[data-cat]').forEach(link => {
      link.onclick = () => {
        document.querySelectorAll('.nav-link[data-tab]').forEach(l => l.classList.remove('active'));
        document.querySelectorAll('.nav-link[data-cat]').forEach(l => l.classList.remove('active'));
        link.classList.add('active');
        currentCategory = link.getAttribute('data-cat');
        currentTab = 'all';
        playBeep(800, 0.04);
        filterAndRender();
      };
    });

    // Real-Time Search Bar
    const inputSearch = document.getElementById('inputSearch');
    inputSearch.oninput = (e) => {
      searchKeyword = e.target.value.toLowerCase().trim();
      filterAndRender();
    };

    async function fetchTelemetry() {
      try {
        let data;
        if (window.pywebview && window.pywebview.api) {
          data = await window.pywebview.api.get_telemetry();
        } else {
          const res = await fetch(`${API_BASE}/telemetry`, { cache: 'no-store' });
          if (!res.ok) throw new Error('API offline');
          data = await res.json();
        }
        updateUIWithTelemetry(data);
      } catch (e) {
        curDownload = 0;
        curLineMbps = 0;
        document.getElementById('speedVal').textContent = "0.0";
        document.getElementById('bandwidthVal').textContent = "0";
        downloadHistory.shift();
        downloadHistory.push(0);
        lineHistory.shift();
        lineHistory.push(0);
        drawChart();
      }
    }

    function updateUIWithTelemetry(data) {
      curDownload = data.aggregate_speed_mb || 0;
      curLineMbps = data.incoming_line_mbps || 0;
      peakSpeed = Math.max(peakSpeed, curDownload);

      document.getElementById('speedVal').textContent = curDownload.toFixed(1);
      document.getElementById('bandwidthVal').textContent = curLineMbps;
      document.getElementById('countActive').textContent = data.active_tasks_count;
      document.getElementById('totalQueueSizeLabel').textContent = data.total_queue_fmt || '0 B';
      document.getElementById('activeConnectionsLabel').textContent = `کانکشن فعال: ${data.active_tasks_count * 16}`;
      document.getElementById('peakSpeedLabel').textContent = `اوج سرعت: ${peakSpeed.toFixed(1)} MB/s`;

      downloadHistory.shift();
      downloadHistory.push(curDownload);

      lineHistory.shift();
      lineHistory.push(curLineMbps > 0 ? (curLineMbps / 8) : 0);

      drawChart();

      allTasksCache = data.tasks || [];
      updateSidebarBadges(allTasksCache);
      filterAndRender();
    }

    function updateSidebarBadges(tasks) {
      const allCount = tasks.length;
      const downloadingCount = tasks.filter(t => t.status === 'downloading' || t.status === 'paused').length;
      const completedCount = tasks.filter(t => t.status === 'completed').length;
      const scheduledCount = tasks.filter(t => t.status === 'queued').length;
      const appCount = tasks.filter(t => t.category === 'app').length;
      const isoCount = tasks.filter(t => t.category === 'iso').length;
      const archiveCount = tasks.filter(t => t.category === 'archive').length;

      document.getElementById('countAll').textContent = allCount;
      document.getElementById('countActive').textContent = downloadingCount;
      document.getElementById('countCompleted').textContent = completedCount;
      document.getElementById('countScheduled').textContent = scheduledCount;
      document.getElementById('countApp').textContent = appCount;
      document.getElementById('countIso').textContent = isoCount;
      document.getElementById('countArchive').textContent = archiveCount;
    }

    function filterAndRender() {
      let filtered = allTasksCache.slice();

      if (currentTab === 'downloading') {
        filtered = filtered.filter(t => t.status === 'downloading' || t.status === 'paused');
      } else if (currentTab === 'completed') {
        filtered = filtered.filter(t => t.status === 'completed');
      } else if (currentTab === 'scheduled') {
        filtered = filtered.filter(t => t.status === 'queued');
      }

      if (currentCategory) {
        filtered = filtered.filter(t => t.category === currentCategory);
      }

      if (searchKeyword) {
        filtered = filtered.filter(t => 
          (t.filename && t.filename.toLowerCase().includes(searchKeyword)) ||
          (t.url && t.url.toLowerCase().includes(searchKeyword))
        );
      }

      renderTasks(filtered);
    }

    function renderTasks(tasks) {
      const queueList = document.getElementById('queueList');
      
      if (!tasks || tasks.length === 0) {
        queueList.innerHTML = `
          <div style="text-align: center; padding: 70px 20px; color: var(--text-muted);">
            <svg width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="margin-bottom: 14px; opacity: 0.4; color: var(--cyan-neon);">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <div style="font-size: 1.1rem; font-weight: 700; margin-bottom: 6px; color: var(--text-main);">صف دانلود خالی است</div>
            <div style="font-size: 0.86rem; color: var(--text-dim); margin-bottom: 18px;">هیچ فایلی برای نمایش وجود ندارد.</div>
            <button class="btn-new-task" onclick="document.getElementById('btnOpenModal').click();" style="display: inline-flex; margin: 0 auto; padding: 8px 18px; font-size: 0.85rem;">
              + افزودن لینک دانلود
            </button>
          </div>
        `;
        return;
      }

      const ph = document.getElementById('queuePlaceholder');
      if (ph) ph.remove();

      const taskIds = new Set(tasks.map(t => `task-${t.id}`));
      Array.from(queueList.children).forEach(child => {
        if (child.id && child.id.startsWith('task-') && !taskIds.has(child.id)) {
          child.remove();
        }
      });

      tasks.forEach(t => {
        let card = document.getElementById(`task-${t.id}`);
        if (!card) {
          card = document.createElement('div');
          card.id = `task-${t.id}`;
          queueList.appendChild(card);
        }

        const isDownloading = t.status === 'downloading';
        const isPaused = t.status === 'paused';
        const isDone = t.status === 'completed';
        card.className = `task-card ${isDownloading ? 'active-state' : ''}`;

        const iconType = (t.category || 'APP').toUpperCase();
        const iconClass = t.category === 'app' ? 'icon-app' : (t.category === 'iso' ? 'icon-iso' : 'icon-zip');
        const doneChunks = t.chunks ? t.chunks.filter(c => c.status === 'done').length : (isDone ? t.num_threads : 0);

        card.innerHTML = `
          <div class="task-top-row">
            <div class="task-file-meta">
              <div class="task-icon ${iconClass}">${iconType}</div>
              <div class="task-name-col">
                <div class="task-filename" title="${t.filename}">${t.filename}</div>
                <div class="task-meta-stats">
                  <span class="stat-pill" style="color: ${isDownloading ? 'var(--cyan-neon)' : (isDone ? 'var(--emerald-neon)' : 'var(--amber-neon)')};">
                    ⚡ <span class="task-spd">${isDownloading ? t.speed_fmt : (isDone ? 'تکمیل شد' : (isPaused ? 'متوقف شده' : t.status))}</span>
                  </span>
                  <span>•</span>
                  <span class="stat-pill" style="color: var(--text-main);">
                    📦 حجم اپ: <strong>${t.downloaded_bytes_fmt}</strong> از <strong>${t.total_size_fmt}</strong> (${t.progress_percent}%)
                  </span>
                  <span>•</span>
                  <span class="stat-pill" style="color: var(--emerald-neon);">
                    زمان باقیمانده: ${isDone ? 'پایان' : t.eta_fmt}
                  </span>
                  <span>•</span>
                  <span style="color: var(--text-muted);">${t.num_threads} کانکشن فعال</span>
                </div>
              </div>
            </div>

            <div class="task-controls">
              ${!isDone ? `
                <button class="btn-circle btn-task-toggle" data-id="${t.id}" data-status="${t.status}" title="${isDownloading ? 'توقف موقت' : 'ادامه دانلود'}">
                  ${isDownloading ? 
                    '<svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6"/></svg>' : 
                    '<svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/></svg>'
                  }
                </button>
              ` : `
                <button class="btn-circle btn-task-folder" data-id="${t.id}" title="نمایش در پوشه ویندوز" style="color: var(--emerald-neon);">
                  <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 19a2 2 0 01-2-2V7a2 2 0 012-2h4l2 2h4a2 2 0 012 2v1M5 19h14a2 2 0 002-2v-5a2 2 0 00-2-2H9a2 2 0 00-2 2v5a2 2 0 01-2 2z" />
                  </svg>
                </button>
              `}
              <button class="btn-circle btn-task-folder" data-id="${t.id}" title="باز کردن پوشه فایل">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                </svg>
              </button>
              <button class="btn-circle danger btn-task-delete" data-id="${t.id}" title="حذف تسک">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
          </div>

          <div class="matrix-box">
            <div class="matrix-header">
              <span>ماتریس قطعات همزمان (MULTI-THREAD CHUNKS)</span>
              <span>${doneChunks} / ${t.num_threads} CONNECTIONS</span>
            </div>
            <div class="matrix-grid">
              ${(t.chunks && t.chunks.length > 0) ? t.chunks.map(c => `
                <div class="thread-block ${c.status === 'done' ? 'done' : (c.status === 'active' ? 'active' : '')}"></div>
              `).join('') : `
                <div class="thread-block ${isDone ? 'done' : ''}"></div><div class="thread-block ${isDone ? 'done' : ''}"></div>
                <div class="thread-block ${isDone ? 'done' : ''}"></div><div class="thread-block ${isDone ? 'done' : ''}"></div>
              `}
            </div>
          </div>
        `;
      });

      // Bind dynamic buttons on each card
      document.querySelectorAll('.btn-task-toggle').forEach(btn => {
        btn.onclick = async (e) => {
          e.stopPropagation();
          const id = btn.getAttribute('data-id');
          const st = btn.getAttribute('data-status');
          playBeep(750, 0.05);
          if (st === 'downloading') {
            await fetch(`${API_BASE}/pause`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ task_id: id })
            }).catch(()=>{});
          } else {
            await fetch(`${API_BASE}/resume`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ task_id: id })
            }).catch(()=>{});
          }
          fetchTelemetry();
        };
      });

      document.querySelectorAll('.btn-task-folder').forEach(btn => {
        btn.onclick = async (e) => {
          e.stopPropagation();
          const id = btn.getAttribute('data-id');
          playBeep(650, 0.05);
          await fetch(`${API_BASE}/open_folder`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ task_id: id })
          }).catch(()=>{});
        };
      });

      document.querySelectorAll('.btn-task-delete').forEach(btn => {
        btn.onclick = async (e) => {
          e.stopPropagation();
          const id = btn.getAttribute('data-id');
          if (!confirm('آیا مطمئن هستید که می‌خواهید این دانلود را حذف کنید؟')) return;
          playBeep(350, 0.08);
          await fetch(`${API_BASE}/delete`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ task_id: id, remove_file: false })
          }).catch(()=>{});
          const el = document.getElementById(`task-${id}`);
          if (el) el.remove();
          fetchTelemetry();
        };
      });
    }

    // Connect Toolbar Buttons
    document.getElementById('btnStartAll').onclick = async () => {
      playBeep(850, 0.06);
      await fetch(`${API_BASE}/resume_all`, { method: 'POST', headers: {'Content-Type': 'application/json'} }).catch(()=>{});
      fetchTelemetry();
    };

    document.getElementById('btnPauseAll').onclick = async () => {
      playBeep(450, 0.06);
      await fetch(`${API_BASE}/pause_all`, { method: 'POST', headers: {'Content-Type': 'application/json'} }).catch(()=>{});
      fetchTelemetry();
    };

    document.getElementById('btnClearCompleted').onclick = async () => {
      playBeep(400, 0.07);
      await fetch(`${API_BASE}/clear_completed`, { method: 'POST', headers: {'Content-Type': 'application/json'} }).catch(()=>{});
      fetchTelemetry();
    };

    // Polling interval
    setInterval(fetchTelemetry, 500);

    // Modal Interaction
    const modal = document.getElementById('modalTask');
    let selectedThreads = 16;

    document.getElementById('btnOpenModal').addEventListener('click', async () => {
      modal.classList.add('show');
      playBeep(700, 0.06);
      try {
        const res = await fetch(`${API_BASE}/clipboard`);
        const data = await res.json();
        if (data.has_url && data.url) {
          document.getElementById('txtUrl').value = data.url;
        }
      } catch(e) {}
      setTimeout(() => document.getElementById('txtUrl').select(), 100);
    });
    document.getElementById('btnCloseModal').addEventListener('click', () => {
      modal.classList.remove('show');
      playBeep(450, 0.05);
    });
    document.getElementById('btnCancelModal').addEventListener('click', () => {
      modal.classList.remove('show');
      playBeep(450, 0.05);
    });

    document.querySelectorAll('.thread-opt').forEach((opt, idx) => {
      opt.addEventListener('click', () => {
        document.querySelectorAll('.thread-opt').forEach(o => o.classList.remove('active'));
        opt.classList.add('active');
        const threadCounts = [4, 8, 16, 32];
        selectedThreads = threadCounts[idx] || 16;
        playBeep(850, 0.04);
      });
    });

    document.getElementById('btnConfirmDownload').addEventListener('click', async () => {
      const url = document.getElementById('txtUrl').value.trim();
      if (!url) return;
      playBeep(950, 0.1);

      try {
        await fetch(`${API_BASE}/add`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url: url, threads: selectedThreads })
        });
      } catch (e) {
        console.log('Added offline or simulating');
      }

      modal.classList.remove('show');
      fetchTelemetry();
    });

    // Limiter
    const rangeLimiter = document.getElementById('rangeLimiter');
    const txtLimit = document.getElementById('txtLimit');
    rangeLimiter.addEventListener('input', (e) => {
      const v = parseInt(e.target.value);
      if (v >= 150) {
        txtLimit.textContent = 'نامحدود';
        txtLimit.style.color = 'var(--cyan-neon)';
      } else {
        txtLimit.textContent = v + ' MB/s';
        txtLimit.style.color = 'var(--amber-neon)';
      }
      fetch(`${API_BASE}/limiter`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ limit: v })
      }).catch(()=>{});
    });

    // Settings Modal
    const modalSettings = document.getElementById('modalSettings');
    const btnOpenSettings = document.getElementById('btnOpenSettings');
    const btnCloseSettings = document.getElementById('btnCloseSettings');
    const btnCancelSettings = document.getElementById('btnCancelSettings');
    const btnSaveSettings = document.getElementById('btnSaveSettings');
    const settingProxyMode = document.getElementById('settingProxyMode');
    const groupCustomProxy = document.getElementById('groupCustomProxy');

    btnOpenSettings.onclick = async () => {
      playBeep(700, 0.05);
      modalSettings.classList.add('show');
      try {
        const res = await fetch(`${API_BASE}/settings`);
        const cfg = await res.json();
        document.getElementById('settingSaveDir').value = cfg.save_directory || '';
        document.getElementById('settingDefaultThreads').value = cfg.default_threads || 16;
        settingProxyMode.value = cfg.proxy_mode || 'auto';
        document.getElementById('settingCustomProxy').value = cfg.custom_proxy || '';
        groupCustomProxy.style.display = cfg.proxy_mode === 'custom' ? 'flex' : 'none';
      } catch(e) {}
    };

    btnCloseSettings.onclick = () => modalSettings.classList.remove('show');
    btnCancelSettings.onclick = () => modalSettings.classList.remove('show');

    settingProxyMode.onchange = () => {
      groupCustomProxy.style.display = settingProxyMode.value === 'custom' ? 'flex' : 'none';
    };

    btnSaveSettings.onclick = async () => {
      playBeep(900, 0.08);
      const newCfg = {
        save_directory: document.getElementById('settingSaveDir').value.trim(),
        default_threads: parseInt(document.getElementById('settingDefaultThreads').value),
        proxy_mode: settingProxyMode.value,
        custom_proxy: document.getElementById('settingCustomProxy').value.trim()
      };
      await fetch(`${API_BASE}/settings`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(newCfg)
      }).catch(()=>{});
      modalSettings.classList.remove('show');
      fetchTelemetry();
    };

    // Keyboard shortcut (Ctrl + N or Ctrl + K for new download)
    window.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && (e.key.toLowerCase() === 'k' || e.key.toLowerCase() === 'n')) {
        e.preventDefault();
        modal.classList.add('show');
        playBeep(700, 0.06);
      }
    });
  </script>
</body>
</html>
