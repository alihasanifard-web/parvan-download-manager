<!DOCTYPE html>
<html lang="fa" dir="rtl" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="logo.svg">
  <link rel="alternate icon" href="icon.ico">
  
  <!-- Modern Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&family=Vazirmatn:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    :root {
      --font-fa: 'Vazirmatn', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
      
      /* OLED Deep Tech Palette (UI/UX Pro Max certified) */
      --bg-base: #07090E;
      --bg-sidebar: #0B0F19;
      --bg-surface: #101626;
      --bg-surface-elevated: #162035;
      --bg-card: rgba(16, 22, 38, 0.75);
      --border-subtle: #1C2740;
      --border-active: #2D3F66;
      
      --cyan-neon: #00F5FF;
      --cyan-glow: rgba(0, 245, 255, 0.28);
      --emerald-neon: #10B981;
      --emerald-glow: rgba(16, 185, 129, 0.25);
      --amber-neon: #F59E0B;
      --violet-neon: #8B5CF6;
      --rose-neon: #F43F5E;
      
      --text-main: #F3F4F6;
      --text-muted: #94A3B8;
      --text-dim: #4B5565;
      
      --radius-sm: 6px;
      --radius-md: 12px;
      --radius-lg: 18px;
      --radius-full: 9999px;
      
      --transition: 200ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
    }

    body {
      font-family: var(--font-fa);
      background-color: var(--bg-base);
      color: var(--text-main);
      height: 100vh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      -webkit-font-smoothing: antialiased;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 5px;
      height: 5px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: var(--border-active);
      border-radius: var(--radius-full);
    }
    ::-webkit-scrollbar-thumb:hover {
      background: var(--cyan-neon);
    }

    /* Top Window Chrome */
    .titlebar {
      height: 48px;
      background: var(--bg-sidebar);
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 16px;
      z-index: 100;
    }

    .titlebar-right-group {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .app-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 800;
      font-size: 0.95rem;
    }

    .brand-icon-box {
      width: 28px;
      height: 28px;
      border-radius: var(--radius-sm);
      background: linear-gradient(135deg, #00F5FF, #2563EB);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #07090E;
      font-weight: 900;
      box-shadow: 0 0 12px var(--cyan-glow);
    }

    .brand-name {
      color: var(--text-main);
      letter-spacing: -0.01em;
    }

    .brand-badge {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      padding: 2px 7px;
      border-radius: var(--radius-full);
      background: rgba(0, 245, 255, 0.12);
      border: 1px solid rgba(0, 245, 255, 0.35);
      color: var(--cyan-neon);
    }

    .titlebar-center {
      display: flex;
      align-items: center;
      gap: 16px;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      padding: 4px 14px;
      border-radius: var(--radius-full);
      font-size: 0.78rem;
      font-family: var(--font-mono);
      color: var(--text-muted);
    }

    .telemetry-indicator {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .pulse-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--emerald-neon);
      box-shadow: 0 0 10px var(--emerald-neon);
      animation: pulseAnim 1.8s infinite;
    }

    @keyframes pulseAnim {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.85); }
    }

    .titlebar-left-group {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .window-controls {
      display: flex;
      align-items: center;
      gap: 8px;
      direction: ltr;
    }

    .win-btn {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      cursor: pointer;
      transition: opacity var(--transition);
    }
    .win-close { background: #FF5F56; }
    .win-min { background: #FFBD2E; }
    .win-max { background: #27C93F; }
    .win-btn:hover { opacity: 0.8; }

    /* App Workspace */
    .app-workspace {
      display: flex;
      flex: 1;
      overflow: hidden;
    }

    /* Sidebar */
    .sidebar {
      width: 250px;
      background: var(--bg-sidebar);
      border-left: 1px solid var(--border-subtle);
      display: flex;
      flex-direction: column;
      padding: 16px 14px;
      gap: 22px;
    }

    .btn-new-task {
      background: linear-gradient(135deg, #00F5FF 0%, #2563EB 100%);
      color: #07090E;
      border: none;
      border-radius: var(--radius-md);
      padding: 12px 16px;
      font-weight: 800;
      font-size: 0.92rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      box-shadow: 0 4px 20px var(--cyan-glow);
      transition: all var(--transition);
      font-family: inherit;
    }
    .btn-new-task:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 26px rgba(0, 245, 255, 0.45);
    }

    .nav-section-title {
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--text-dim);
      margin-bottom: 8px;
      padding: 0 8px;
    }

    .nav-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .nav-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 9px 12px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      color: var(--text-muted);
      font-size: 0.88rem;
      font-weight: 500;
      transition: all var(--transition);
    }
    .nav-link:hover {
      background: var(--bg-surface);
      color: var(--text-main);
    }
    .nav-link.active {
      background: var(--bg-surface-elevated);
      color: var(--cyan-neon);
      font-weight: 700;
    }

    .nav-link-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .badge-count {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      padding: 2px 7px;
      border-radius: var(--radius-full);
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      color: var(--text-dim);
    }
    .nav-link.active .badge-count {
      border-color: rgba(0, 245, 255, 0.4);
      color: var(--cyan-neon);
    }

    /* Speed Limiter in Sidebar */
    .sidebar-limiter {
      margin-top: auto;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 14px;
    }

    .limiter-header {
      display: flex;
      justify-content: space-between;
      font-size: 0.76rem;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 10px;
    }

    .slider-styled {
      width: 100%;
      height: 4px;
      -webkit-appearance: none;
      background: var(--border-active);
      border-radius: var(--radius-full);
      outline: none;
      cursor: pointer;
    }
    .slider-styled::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: var(--cyan-neon);
      box-shadow: 0 0 10px var(--cyan-glow);
      cursor: pointer;
      transition: transform var(--transition);
    }
    .slider-styled::-webkit-slider-thumb:hover {
      transform: scale(1.2);
    }

    /* Main Area */
    .main-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      background: var(--bg-base);
      overflow: hidden;
    }

    /* Top Telemetry Dashboard (3 Key Metrics: Download Speed, Incoming Internet Line, Total Volume) */
    .telemetry-dashboard {
      padding: 16px 24px;
      border-bottom: 1px solid var(--border-subtle);
      background: linear-gradient(180deg, rgba(16, 22, 38, 0.8) 0%, rgba(7, 9, 14, 0.4) 100%);
      display: grid;
      grid-template-columns: 240px 240px 1fr;
      gap: 20px;
      align-items: center;
    }

    .metric-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 14px 18px;
      position: relative;
      overflow: hidden;
    }
    .metric-card.accent-cyan { border-top: 3px solid var(--cyan-neon); }
    .metric-card.accent-emerald { border-top: 3px solid var(--emerald-neon); }

    .metric-title {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 4px;
    }

    .metric-value {
      font-family: var(--font-mono);
      font-size: 1.85rem;
      font-weight: 800;
      display: flex;
      align-items: baseline;
      gap: 6px;
      letter-spacing: -0.02em;
    }

    .val-cyan {
      color: var(--cyan-neon);
      text-shadow: 0 0 16px var(--cyan-glow);
    }
    .val-emerald {
      color: var(--emerald-neon);
      text-shadow: 0 0 16px var(--emerald-glow);
    }

    .metric-unit {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--text-muted);
    }

    .metric-sub {
      font-size: 0.72rem;
      font-family: var(--font-mono);
      color: var(--text-dim);
      margin-top: 2px;
      display: flex;
      justify-content: space-between;
    }

    /* Live Graph Box */
    .chart-box {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 10px 14px;
      height: 94px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
    }

    .chart-legend {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.72rem;
      font-family: var(--font-mono);
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 6px;
      color: var(--text-muted);
    }

    .legend-bullet {
      width: 8px;
      height: 8px;
      border-radius: 2px;
    }

    canvas#dualSpeedChart {
      width: 100%;
      height: 52px;
      display: block;
    }

    /* Action Toolbar */
    .action-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 24px;
      border-bottom: 1px solid var(--border-subtle);
    }

    .search-wrap {
      position: relative;
      width: 280px;
    }

    .search-bar {
      width: 100%;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 8px 36px 8px 12px;
      color: var(--text-main);
      font-size: 0.85rem;
      outline: none;
      font-family: inherit;
      transition: all var(--transition);
    }
    .search-bar:focus {
      border-color: var(--cyan-neon);
      box-shadow: 0 0 12px var(--cyan-glow);
    }

    .search-icon-pos {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-dim);
      width: 16px;
      height: 16px;
      pointer-events: none;
    }

    .toolbar-buttons {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .btn-pill {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      color: var(--text-muted);
      border-radius: var(--radius-sm);
      padding: 7px 14px;
      font-size: 0.82rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      font-family: inherit;
      transition: all var(--transition);
    }
    .btn-pill:hover {
      background: var(--bg-surface-elevated);
      color: var(--text-main);
      border-color: var(--border-active);
    }

    /* Tasks Queue View */
    .queue-scroll {
      flex: 1;
      overflow-y: auto;
      padding: 18px 24px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    /* Task Card */
    .task-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 16px 20px;
      transition: all var(--transition);
      display: flex;
      flex-direction: column;
      gap: 14px;
      position: relative;
    }
    .task-card:hover {
      border-color: var(--border-active);
      background: var(--bg-card);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
    }
    .task-card.active-state {
      border-right: 3px solid var(--cyan-neon);
    }

    .task-top-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .task-file-meta {
      display: flex;
      align-items: center;
      gap: 16px;
      flex: 1;
      min-width: 0;
    }

    .task-icon {
      width: 44px;
      height: 44px;
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 0.76rem;
      font-family: var(--font-mono);
      flex-shrink: 0;
    }
    .icon-app { background: rgba(0, 245, 255, 0.12); color: var(--cyan-neon); border: 1px solid rgba(0, 245, 255, 0.3); }
    .icon-iso { background: rgba(139, 92, 246, 0.12); color: var(--violet-neon); border: 1px solid rgba(139, 92, 246, 0.3); }
    .icon-zip { background: rgba(245, 158, 11, 0.12); color: var(--amber-neon); border: 1px solid rgba(245, 158, 11, 0.3); }

    .task-name-col {
      min-width: 0;
      flex: 1;
    }

    .task-filename {
      font-weight: 700;
      font-size: 0.96rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      color: var(--text-main);
      direction: ltr;
      text-align: right;
    }

    .task-meta-stats {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 0.78rem;
      font-family: var(--font-mono);
      color: var(--text-muted);
      margin-top: 4px;
      flex-wrap: wrap;
    }

    .stat-pill {
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .task-controls {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .btn-circle {
      width: 34px;
      height: 34px;
      border-radius: var(--radius-sm);
      background: var(--bg-surface-elevated);
      border: 1px solid var(--border-subtle);
      color: var(--text-muted);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all var(--transition);
    }
    .btn-circle:hover {
      background: var(--border-active);
      color: var(--text-main);
    }
    .btn-circle.danger:hover {
      background: rgba(244, 63, 94, 0.2);
      border-color: var(--rose-neon);
      color: var(--rose-neon);
    }

    /* 16-Thread Visualizer Matrix */
    .matrix-box {
      background: rgba(7, 9, 14, 0.6);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      padding: 10px 12px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .matrix-header {
      display: flex;
      justify-content: space-between;
      font-size: 0.72rem;
      font-family: var(--font-mono);
      color: var(--text-muted);
    }

    .matrix-grid {
      display: grid;
      grid-template-columns: repeat(16, 1fr);
      gap: 4px;
      height: 12px;
    }

    .thread-block {
      background: var(--border-subtle);
      border-radius: 2px;
      transition: all 250ms;
    }
    .thread-block.done {
      background: var(--cyan-neon);
      box-shadow: 0 0 6px var(--cyan-glow);
    }
    .thread-block.active {
      background: linear-gradient(90deg, #00F5FF, #2563EB);
      animation: pulseBlock 1.2s infinite alternate;
    }
    @keyframes pulseBlock {
      0% { opacity: 0.35; }
      100% { opacity: 1; }
    }

    /* Modal for New Task */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 200;
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--transition);
    }
    .modal-overlay.show {
      opacity: 1;
      pointer-events: auto;
    }

    .modal-box {
      width: 580px;
      background: var(--bg-surface);
      border: 1px solid var(--border-active);
      border-radius: var(--radius-lg);
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.9), 0 0 35px var(--cyan-glow);
      overflow: hidden;
      transform: scale(0.96);
      transition: transform var(--transition);
    }
    .modal-overlay.show .modal-box {
      transform: scale(1);
    }

    .modal-head {
      padding: 16px 22px;
      background: var(--bg-surface-elevated);
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-weight: 700;
    }

    .modal-content {
      padding: 22px;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .input-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .input-label {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-muted);
    }

    .input-text {
      background: var(--bg-base);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      padding: 10px 14px;
      color: var(--text-main);
      font-family: var(--font-mono);
      font-size: 0.86rem;
      direction: ltr;
      outline: none;
    }
    .input-text:focus {
      border-color: var(--cyan-neon);
      box-shadow: 0 0 10px var(--cyan-glow);
    }

    .thread-select-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
    }

    .thread-opt {
      padding: 8px;
      background: var(--bg-base);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      text-align: center;
      font-family: var(--font-mono);
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-muted);
      cursor: pointer;
      transition: all var(--transition);
    }
    .thread-opt.active {
      background: rgba(0, 245, 255, 0.15);
      border-color: var(--cyan-neon);
      color: var(--cyan-neon);
    }

    .modal-bottom {
      padding: 16px 22px;
      background: var(--bg-surface-elevated);
      border-top: 1px solid var(--border-subtle);
      display: flex;
      justify-content: flex-end;
      gap: 12px;
    }
  </style>
</head>
<body>

  <!-- Window Header -->
  <header class="titlebar">
    <div class="titlebar-right-group">
      <div class="app-brand">
        <img src="logo.svg" alt="Parvan Logo" style="width: 30px; height: 30px; filter: drop-shadow(0 0 8px var(--cyan-glow));" />
        <span class="brand-name">پروان دانلود منیجر</span>
        <span class="brand-badge">PARVAN DL v2.5</span>
      </div>
    </div>

    <div class="titlebar-center">
      <div class="telemetry-indicator">
        <span class="pulse-dot"></span>
        <span>LINE STATUS: OPTIMAL</span>
      </div>
      <span>|</span>
      <div>RELAY: <span style="color: var(--text-main);">TEHRAN-IX / FRANKFURT</span></div>
      <span>|</span>
      <div>LATENCY: <span style="color: var(--emerald-neon);">18ms</span></div>
    </div>

    <div class="titlebar-left-group">
      <button class="btn-pill" id="btnOpenSettings" style="padding: 4px 10px; font-size: 0.78rem;">
